# ai-python 环境变量模板
#
# 使用方式：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
#   cp ai-python/.env.example ai-python/.env
#
# app/config.py 的 Settings 自动读取 .env 与系统环境变量，统一使用 LINGXI_ 前缀；
# 系统环境变量优先级高于 .env（容器化部署时用环境变量注入即可，无需 .env）。

# ---------- 服务信息 ----------
LINGXI_APP_NAME=ai-python

# ---------- LLM 网关（DeepSeek 主模型 + qwen/glm/kimi 备用降级链） ----------
# 降级链：逗号分隔的 Provider 名，按顺序降级；**未配置密钥的 Provider 自动跳过**。
# 取值只能来自 deepseek / qwen / glm / kimi；只配 DeepSeek 时链即退化为单 Provider。
LINGXI_LLM_PROVIDER_CHAIN=deepseek,qwen,glm,kimi

LINGXI_DEEPSEEK_API_KEY=
LINGXI_DEEPSEEK_BASE_URL=https://api.deepseek.com
LINGXI_DEEPSEEK_MODEL=deepseek-chat

# 通义千问（阿里云 DashScope OpenAI 兼容模式）：https://dashscope.aliyuncs.com/compatible-mode/v1
LINGXI_QWEN_API_KEY=
LINGXI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LINGXI_QWEN_MODEL=qwen-plus

# 智谱 GLM-4（OpenAI 兼容协议）：https://open.bigmodel.cn/api/paas/v4
LINGXI_GLM_API_KEY=
LINGXI_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LINGXI_GLM_MODEL=glm-4-plus

# Kimi（Moonshot，OpenAI 兼容协议）：https://api.moonshot.cn/v1
LINGXI_KIMI_API_KEY=
LINGXI_KIMI_BASE_URL=https://api.moonshot.cn/v1
LINGXI_KIMI_MODEL=moonshot-v1-8k

# 调用约束：首字 10s / 总 120s；指数退避等待 base * 2^(n-1) 秒
LINGXI_LLM_TIMEOUT=120.0
LINGXI_LLM_FIRST_TOKEN_TIMEOUT=10.0
LINGXI_LLM_MAX_RETRIES=2
LINGXI_LLM_RETRY_BACKOFF_BASE=0.5

# ---------- Kafka 事件总线（M3-3.8 流式全链路） ----------
# kafka_enabled=false 时不起消费协程（本地无 Kafka 也可启动服务）；
# 需完整流式链路时置 true，并确保 Kafka 与三个主题已就绪。
LINGXI_KAFKA_ENABLED=false
LINGXI_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
LINGXI_KAFKA_CONSUMER_GROUP=lingxi-ai
LINGXI_KAFKA_TOPIC_SESSION_MESSAGE=lingxi.session.message
LINGXI_KAFKA_TOPIC_AI_CHUNK=lingxi.ai.chunk
LINGXI_KAFKA_TOPIC_AI_REPLY=lingxi.ai.reply
# 上下文窗口（M3-3.11）：AI 压缩旧消息后回写会话摘要（Java 消费并随下一轮事件带回）
LINGXI_KAFKA_TOPIC_SESSION_SUMMARY=lingxi.session.summary

# 知识库链路（M3-3.2）：消费 kb.doc.ingest → 入库 → 回写 kb.doc.indexed；
# 消费 kb.doc.delete → 清理向量库切片
LINGXI_KAFKA_TOPIC_KB_INGEST=kb.doc.ingest
LINGXI_KAFKA_TOPIC_KB_INDEXED=kb.doc.indexed
LINGXI_KAFKA_TOPIC_KB_DELETE=kb.doc.delete
LINGXI_KAFKA_KB_CONSUMER_GROUP=lingxi-ai-kb
LINGXI_KAFKA_KB_DELETE_CONSUMER_GROUP=lingxi-ai-kb-delete
LINGXI_KB_DOWNLOAD_TIMEOUT=60.0

# ---------- 知识库：Milvus 向量检索 ----------
LINGXI_MILVUS_URI=http://127.0.0.1:19530
LINGXI_MILVUS_CHUNK_COLLECTION=lingxi_kb_chunk
LINGXI_MILVUS_COLLECTION_VERSION=v1

# ---------- Embedding 通道（方案 C：云端稠密 + 本地稀疏） ----------
# provider 取值：cloud-hybrid（默认，需云端稠密 API Key）| bge-m3（本机自部署）| hash（离线开发）
LINGXI_EMBEDDER_PROVIDER=cloud-hybrid
LINGXI_EMBED_DIM=1024
LINGXI_EMBED_BATCH_SIZE=16
# 查询向量缓存（首字延迟优化）：命中即跳过云端网络往返
LINGXI_EMBED_CACHE_SIZE=512
LINGXI_EMBED_CACHE_TTL=300.0

# 云端稠密嵌入（OpenAI 兼容 /v1/embeddings，Provider 无关）
# 默认指向**国内低延迟服务**（硅基流动，直连 RTT 几十 ms，推荐）；
# 如改用 OpenRouter（境外，RTT 明显更高）只需替换下面三行，代码无需改动：
#   LINGXI_DENSE_EMBED_BASE_URL=https://openrouter.ai/api/v1
#   LINGXI_DENSE_EMBED_MODEL=baai/bge-m3
#   LINGXI_DENSE_EMBED_API_KEY=sk-or-v1-...
LINGXI_DENSE_EMBED_API_KEY=
LINGXI_DENSE_EMBED_BASE_URL=https://api.siliconflow.cn/v1
LINGXI_DENSE_EMBED_MODEL=BAAI/bge-m3
LINGXI_DENSE_EMBED_TIMEOUT=30.0
LINGXI_DENSE_EMBED_MAX_RETRIES=2

# ---------- 检索参数（混合检索 → 精排） ----------
# 候选数影响精排耗时（成本随候选数增长）；精细召回优先可调大到 20
LINGXI_RETRIEVE_CANDIDATE_K=10
LINGXI_RETRIEVE_TOP_K=5

# ---------- Rerank 精排（云端 bge-reranker-v2-m3） ----------
# provider 取值：cloud（云端 REST，默认，需 API Key）| none（降级为 RRF 顺序，不精排）
# base_url 以硅基流动（SiliconFlow）默认值托管 BAAI/bge-reranker-v2-m3；
# 亦可替换为 Jina（https://api.jina.ai/v1）/ Cohere（https://api.cohere.com/v2）等同类 REST。
# 密钥缺失或调用失败时自动降级为 RRF 融合顺序，不阻断检索链路。
LINGXI_RERANK_PROVIDER=cloud
LINGXI_RERANK_API_KEY=
LINGXI_RERANK_BASE_URL=https://api.siliconflow.cn/v1
LINGXI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LINGXI_RERANK_TIMEOUT=10.0
LINGXI_RERANK_MAX_RETRIES=1

# ---------- PII 脱敏（M3-3.9） ----------
# 手机/身份证/银行卡/邮箱/地址在进入云端模型（LLM 与 embedding）前替换为占位符，
# 回答与流出片段再还原为原文；入库向量化前同样脱敏（原文仍入库供引用展示）。
LINGXI_PII_ENABLED=true
# 地址为启发式识别（可能误伤含「路/街/巷」等词的业务文本），必要时可关闭
LINGXI_PII_MASK_ADDRESS=true

# ---------- 评测中心（M3-3.10） ----------
# Golden Set 回归使用独立租户/知识库（与业务数据隔离）；数据集中内置
# （app/evaluator/golden/cases.json）与种子知识文档（golden/kb/*.md）。
LINGXI_EVAL_SEED_TENANT_ID=eval-tenant
LINGXI_EVAL_SEED_KB_ID=eval-kb
# 空 = 用内置数据集；报告与 Badcase 落盘目录（空 = 系统临时目录下的 lingxi-eval）
LINGXI_EVAL_DATASET_PATH=
LINGXI_EVAL_REPORT_DIR=

# ---------- Agent 运行时 / 上下文窗口（M3-3.7 / M3-3.11） ----------
# 单轮对话保留的近期消息数上限（原文）；更早的旧消息压缩为摘要并回写 Java 会话
LINGXI_AGENT_HISTORY_MAX_MESSAGES=20
LINGXI_AGENT_SUMMARY_ENABLED=true
LINGXI_AGENT_SUMMARY_MAX_CHARS=600
# 记忆维护（摘要/画像合并）硬性总超时：非关键路径，防单次抖动长时间占用资源
# （网关内部最坏耗时 = providers × (retries+1) × timeout，曾因此把消费协程拖过
#  Kafka max.poll.interval.ms 而被踢出消费组）
LINGXI_AGENT_SUMMARY_TIMEOUT_SECONDS=30.0
# 消费活性：单条处理超过该间隔会被踢出消费组；消费异常退出后按退避自动重建
LINGXI_KAFKA_MAX_POLL_INTERVAL_MS=300000
LINGXI_KAFKA_CONSUMER_RESTART_BACKOFF_SECONDS=5.0

# ---------- 坐席快捷回复同步通道（M4-4.6） ----------
# gRPC 同步（Go→Java→Python）+ 独立并发闸门 + 超载回落 Kafka 异步（结果只推坐席端）。
# 闸门满或生成超时 → 同步返回 degraded（Java 据此转异步），不挤压对话主链路。
LINGXI_SUGGEST_GRPC_ENABLED=true
LINGXI_SUGGEST_GRPC_PORT=9095
LINGXI_SUGGEST_GATE=32
LINGXI_SUGGEST_QUEUE_WAIT_SECONDS=0.0
LINGXI_SUGGEST_TIMEOUT_SECONDS=3.5
LINGXI_SUGGEST_MAX_CONCURRENT_RPCS=64
LINGXI_SUGGEST_MAX_CANDIDATES=3
LINGXI_KAFKA_TOPIC_AI_SUGGEST_REQUEST=lingxi.ai.suggest.request
LINGXI_KAFKA_TOPIC_AI_SUGGEST_RESULT=lingxi.ai.suggest.result
LINGXI_KAFKA_SUGGEST_CONSUMER_GROUP=lingxi-ai-suggest
# 会话消息事件未携带租户/知识库时的兜底
LINGXI_AGENT_DEFAULT_TENANT_ID=default
LINGXI_AGENT_DEFAULT_KB_ID=

# ---------- 工具链（M4-4.1 ~ 4.3） ----------
# Function Calling + JSON Schema 强校验 + 白名单 + 全量审计
LINGXI_AGENT_TOOLS_ENABLED=true
LINGXI_TOOL_TIMEOUT_SECONDS=5.0
LINGXI_TOOL_MAX_RETRIES=1
LINGXI_TOOL_MAX_ROUNDS=3
LINGXI_TOOL_AUDIT_ENABLED=true
LINGXI_KAFKA_TOPIC_TOOL_AUDIT=lingxi.tool.audit
# Java 业务域 gRPC（业务工具同步通道）
LINGXI_BUSINESS_GRPC_TARGET=127.0.0.1:9090
LINGXI_BUSINESS_GRPC_TIMEOUT_SECONDS=5.0

# ---------- 跨会话长期记忆（M4-4.4） ----------
# 用户级「画像摘要」存 Redis（KV，按 tenant+user 隔离），新会话每轮注入提示词。
# 仅在历史超出窗口（触发会话摘要压缩）时才顺带合并画像，普通短会话零额外模型调用。
# 画像不含 PII（写入前净化 + 注入前脱敏兜底）；Redis 异常时静默降级，不阻断问答。
LINGXI_AGENT_MEMORY_ENABLED=true
LINGXI_AGENT_MEMORY_MERGE_ENABLED=true
LINGXI_AGENT_MEMORY_MAX_CHARS=400
LINGXI_AGENT_MEMORY_TTL_SECONDS=2592000
LINGXI_AGENT_MEMORY_TIMEOUT_SECONDS=1.0
# Redis（与 core-java application.yml 同源，共享实例；靠 key 前缀隔离命名空间）
LINGXI_REDIS_HOST=127.0.0.1
LINGXI_REDIS_PORT=6379
LINGXI_REDIS_DB=0
LINGXI_REDIS_PASSWORD=
# RESP 协议版本：默认 2（redis-py 8.x 默认 RESP3 会先发 HELLO，旧版 Redis < 6.0 不支持）
LINGXI_REDIS_PROTOCOL=2

# ---------- 人工接管联动（M4-4.5） ----------
# 三类规则命中即跳过 AI 生成、回固定话术并通知 Java 转人工（会话转入 WAITING_HUMAN）；
# 坐席接管/转人工成功时 Java 发 lingxi.session.takeover，本侧立即终止正在生成的回答。
LINGXI_AGENT_HANDOFF_ENABLED=true
LINGXI_AGENT_HANDOFF_USER_KEYWORDS=转人工,人工客服,人工服务,找人工,转接人工
LINGXI_AGENT_HANDOFF_EMOTION_KEYWORDS=投诉,举报,骗子,诈骗,垃圾,退钱,赔偿,维权,差评,监管,报警,告你们
LINGXI_AGENT_HANDOFF_EMOTION_MIN_HITS=2
# 低置信度：①检索命中为空（默认启用，与分数量纲无关）②精排分低于阈值（默认关闭）
LINGXI_AGENT_HANDOFF_EMPTY_HITS_ENABLED=true
LINGXI_AGENT_HANDOFF_LOW_SCORE_ENABLED=false
LINGXI_AGENT_HANDOFF_LOW_SCORE_THRESHOLD=0.3
LINGXI_AGENT_HANDOFF_REPLY_TEXT=已为您转接人工客服，请稍候，正在为您安排坐席。
LINGXI_AGENT_HANDOFF_INTERRUPT_TTL_SECONDS=300.0
LINGXI_KAFKA_TOPIC_AI_HANDOFF=lingxi.ai.handoff
LINGXI_KAFKA_TOPIC_SESSION_TAKEOVER=lingxi.session.takeover
LINGXI_KAFKA_TAKEOVER_CONSUMER_GROUP=lingxi-ai-takeover
