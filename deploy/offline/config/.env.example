# 灵犀智能平台 —— 离线交付环境变量样例（.env.example）
#
# 用法：复制为 config/.env 并在**离线目标机**填入真实值：
#     cp config/.env.example config/.env
# 四端启动脚本（scripts/start-all.sh）会读取它；也可用系统环境变量直接注入（优先级更高）。
#
# 生产必改项已用 [必改] 标注：沿用样例默认值等于把密钥与初始口令留成公开值。
# 本文件中的地址默认指向「单机一体化」部署（全部组件在同一台机器）。

# ===== 安全与身份（[必改]）=====
# 网关与 core-java 共享的 JWT 签名密钥：≥32 字节随机串，两端必须一致
#   生成：openssl rand -base64 48
LINGXI_JWT_SECRET=lingxi-dev-secret-change-me-please-32bytes
GATEWAY_JWT_SECRET=${LINGXI_JWT_SECRET}
# 内置管理员初始口令（首启落库，生产必改）
LINGXI_ADMIN_INIT_PASSWORD=lingxi@2026
LINGXI_ADMIN_USERNAME=admin
# 默认租户：网关请求缺省归属租户
GATEWAY_DEFAULT_TENANT=lingxi
LINGXI_DEFAULT_TENANT=${GATEWAY_DEFAULT_TENANT}
LINGXI_AUTH_ENABLED=true
GATEWAY_ENABLE_AUTH=true

# ===== MySQL（业务库；外部依赖，非本包自带）=====
# 生产建议：独立账号 + 强口令，勿用 root/样例口令
LINGXI_DB_URL=jdbc:mysql://127.0.0.1:3306/lingxi?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
LINGXI_DB_USER=root
LINGXI_DB_PASSWORD=ideal0921

# ===== Redis（缓存/队列/长期记忆）=====
LINGXI_REDIS_HOST=127.0.0.1
LINGXI_REDIS_PORT=6379
LINGXI_REDIS_PASSWORD=
LINGXI_REDIS_DB=0

# ===== Kafka（事件总线；LINGXI_KAFKA_ENABLED=false 时三端均不起消费，可无 Kafka 运行）=====
LINGXI_KAFKA_ENABLED=true
LINGXI_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
GATEWAY_KAFKA_ENABLED=${LINGXI_KAFKA_ENABLED}
GATEWAY_KAFKA_BROKERS=${LINGXI_KAFKA_BOOTSTRAP_SERVERS}

# ===== Milvus（向量检索）=====
LINGXI_MILVUS_URI=http://127.0.0.1:19530

# ===== MinIO（知识库对象存储，复用 Milvus 栈的 MinIO）=====
LINGXI_KB_MINIO_ENDPOINT=http://127.0.0.1:9000
LINGXI_KB_MINIO_ACCESS_KEY=minioadmin
LINGXI_KB_MINIO_SECRET_KEY=minioadmin
LINGXI_KB_MINIO_BUCKET=lingxi-kb

# ===== Nacos（注册中心，当前 core-java 未引用，可选）=====
NACOS_HOME=/opt/lingxi/nacos
NACOS_SERVER_ADDR=127.0.0.1:8848

# ===== LLM / Embedding / Rerank 通道（[必改]：填真实 API Key）=====
# 未配置 Key 的 Provider 会被自动跳过（降级链），但至少需一个可用
LINGXI_LLM_PROVIDER_CHAIN=deepseek
LINGXI_DEEPSEEK_API_KEY=
LINGXI_DEEPSEEK_BASE_URL=https://api.deepseek.com
LINGXI_DEEPSEEK_MODEL=deepseek-chat
LINGXI_DENSE_EMBED_API_KEY=
LINGXI_DENSE_EMBED_BASE_URL=https://api.siliconflow.cn/v1
LINGXI_DENSE_EMBED_MODEL=BAAI/bge-m3
LINGXI_RERANK_API_KEY=
LINGXI_RERANK_BASE_URL=https://api.siliconflow.cn/v1
LINGXI_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 中间件安装路径覆盖（按目标机实况调整）=====
KAFKA_HOME=/opt/lingxi/kafka
KAFKA_DATA=/opt/lingxi/kafka-data
MYSQL_SERVER=/usr/local/mysql/support-files/mysql.server
