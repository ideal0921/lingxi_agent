<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lingxi</groupId>
        <artifactId>lingxi-core</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lingxi-start</artifactId>
    <name>lingxi-start</name>
    <description>启动聚合模块：装配 common / gateway-api 与各业务域</description>

    <dependencies>
        <dependency>
            <groupId>com.lingxi</groupId>
            <artifactId>lingxi-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lingxi</groupId>
            <artifactId>lingxi-gateway-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lingxi</groupId>
            <artifactId>lingxi-session</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lingxi</groupId>
            <artifactId>lingxi-ticket</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lingxi</groupId>
            <artifactId>lingxi-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lingxi</groupId>
            <artifactId>lingxi-business</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lingxi</groupId>
            <artifactId>lingxi-workflow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 本地中间件接线：MySQL（业务持久化）/ Redis（缓存与队列，本地单机模式） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- WebClient 出站 HTTP 集成（Servlet 栈下仅启用客户端能力，不切换容器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- 事件总线（M3-3.8 流式全链路）：发布会话消息事件 + 消费 AI 回答落库 -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 进程内 gRPC 传输（M4-4.6 同步通道离线单测）：不触网，仅测试期使用。
             版本与 gateway-api 的 grpc.version 保持一致 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>1.71.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可执行 jar 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
