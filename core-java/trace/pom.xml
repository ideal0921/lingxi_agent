<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lingxi</groupId>
        <artifactId>lingxi-core</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lingxi-trace</artifactId>
    <name>lingxi-trace</name>
    <description>接口链路追踪域：HTTP/gRPC/Kafka span 采集、异步批量落库与查询 API（M5-5.9）</description>

    <dependencies>
        <dependency>
            <groupId>com.lingxi</groupId>
            <artifactId>lingxi-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 批量落库（JdbcTemplate.batchUpdate）；可切换存储实现 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- gRPC 服务端拦截器：仅需 API 层（ServerInterceptor/Metadata/Status/ForwardingServerCall） -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
