<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>com.lingxi</groupId>
    <artifactId>lingxi-core</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>lingxi-core</name>
    <description>核心业务域（M1 骨架：common + start，业务域模块 M2 填充）</description>

    <modules>
        <module>common</module>
        <module>gateway-api</module>
        <module>log</module>
        <module>user</module>
        <module>session</module>
        <module>ticket</module>
        <module>knowledge</module>
        <module>business</module>
        <module>workflow</module>
        <module>report</module>
        <module>start</module>
    </modules>

    <properties>
        <!-- 目标运行时：JDK 21 (LTS)，通过 JAVA_HOME 切换本机 1.8/17/21 -->
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 对象存储客户端（知识库原始文件，M3-3.2） -->
        <minio.version>8.5.12</minio.version>
        <!-- gRPC Java 版本（M5-5.5 起由父 POM 统一管理；与 ai-python grpcio 协议版本同源） -->
        <grpc.version>1.71.0</grpc.version>
        <!-- JWT（M5-5.6 认证）：与 Go 网关 golang-jwt/v5 同为 HS256，密钥经环境变量共享 -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>
</project>
